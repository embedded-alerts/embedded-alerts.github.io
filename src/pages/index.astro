---
import document from '../../index.html?raw';

const head = document.match(/<head[^>]*>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const body = document.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';
---

<!doctype html>
<html lang="en">
  <head set:html={head}></head>
  <body set:html={body}></body>
</html>
